{
  "name": "DICOM_MANIFEST_SERIES",
  "description": "This table contains a manifest's series level metadata.",
  "primaryKey": [
    {
      "columnName": "MANIFEST_ID",
      "ordinalPosition": 1
    },
    {
      "columnName": "CONTACT_DATE_REAL",
      "ordinalPosition": 2
    },
    {
      "columnName": "LINE",
      "ordinalPosition": 3
    }
  ],
  "columns": [
    {
      "ordinalPosition": 1,
      "name": "MANIFEST_ID",
      "type": "NUMERIC",
      "discontinued": false,
      "description": "The unique identifier (.1 item) for the subject name record."
    },
    {
      "ordinalPosition": 2,
      "name": "CONTACT_DATE_REAL",
      "type": "FLOAT",
      "discontinued": false,
      "description": "A unique contact date in decimal format. The integer portion of the number indicates the date of contact. The digits after the decimal distinguish different contacts on the same date and are unique for each contact on that date. For example, .00 is the first/only contact, .01 is the second contact, etc."
    },
    {
      "ordinalPosition": 3,
      "name": "LINE",
      "type": "INTEGER",
      "discontinued": false,
      "description": "The line number for the information associated with this contact. Multiple pieces of information can be associated with this contact."
    },
    {
      "ordinalPosition": 4,
      "name": "UID_IDENT",
      "type": "VARCHAR",
      "discontinued": false,
      "description": "The Series Instance UID for this imaging series (attribute 0020,000E)."
    },
    {
      "ordinalPosition": 5,
      "name": "MODALITY_C_NAME",
      "type": "VARCHAR",
      "discontinued": false,
      "description": "The DICOM Series modality type (attribute 0008,0060).",
